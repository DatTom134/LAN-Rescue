<UserControl x:Class="LANRescue.ConsoleApp.Views.IpConflictView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="IP conflicts" FontSize="25" FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}"/>
        <TextBlock Text="Illustrative conflict records. The ARP cache alone cannot identify the intended target."
                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,18" TextWrapping="Wrap"/>
        <Border Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1"
                CornerRadius="9" Padding="14" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Important safety rule" Foreground="#9A3412" FontWeight="Bold"/>
                <TextBlock Text="Do not change an endpoint's IP until its Agent identity is authenticated through a working management channel independent of the conflicting IPv4."
                           Foreground="#9A3412" Margin="0,5,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <Border Background="White" CornerRadius="10" Padding="18">
            <StackPanel>
                <TextBlock Text="Conflict group: 192.168.110.93" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="Gateway: 192.168.110.9  |  Subnet: 255.255.255.0"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,12"/>
                <DataGrid Height="190">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Device" Binding="{Binding DeviceName}" Width="*"/>
                        <DataGridTextColumn Header="Sample MAC" Binding="{Binding MacAddress}" Width="1.5*"/>
                        <DataGridTextColumn Header="Target identity" Binding="{Binding Identity}" Width="1.3*"/>
                        <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="1.2*"/>
                    </DataGrid.Columns>
                    <DataGrid.Items>
                        <local:ConflictRow xmlns:local="clr-namespace:LANRescue.ConsoleApp.Views"
                                           DeviceName="QA-PC-02 (B)" MacAddress="BB-BB-BB-BB-BB-BB"
                                           Identity="Not verified" Evidence="Sample record"/>
                        <local:ConflictRow xmlns:local="clr-namespace:LANRescue.ConsoleApp.Views"
                                           DeviceName="QA-PC-03 (C)" MacAddress="CC-CC-CC-CC-CC-CC"
                                           Identity="Not verified" Evidence="Sample record"/>
                    </DataGrid.Items>
                </DataGrid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
