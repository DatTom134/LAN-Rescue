<UserControl x:Class="LANRescue.ConsoleApp.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Diagnostics" FontSize="25" FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}"/>
        <TextBlock Text="Planned read-only diagnostic checks. Results below are examples, not live measurements."
                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,18" TextWrapping="Wrap"/>
        <Border Background="White" CornerRadius="10" Padding="20">
            <StackPanel>
                <TextBlock Text="Sample diagnostic checklist" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14"/>
                <TextBlock Text="●  Adapter status — Not queried" Margin="0,7"/>
                <TextBlock Text="●  IPv4 / subnet / gateway — Sample only" Margin="0,7"/>
                <TextBlock Text="●  ARP / neighbor cache — Not queried" Margin="0,7"/>
                <TextBlock Text="●  Gateway connectivity — Not tested" Margin="0,7"/>
                <TextBlock Text="●  DNS resolution — Not tested" Margin="0,7"/>
                <TextBlock Text="●  Agent channel — Not implemented" Margin="0,7"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
