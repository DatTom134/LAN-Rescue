<UserControl x:Class="LANRescue.ConsoleApp.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <StackPanel Margin="0,0,0,22">
                <TextBlock Text="Network overview" FontSize="25" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="A sample snapshot of managed endpoints and network health."
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"/>
            </StackPanel>
            <UniformGrid Columns="4" Margin="0,0,0,22">
                <Border Background="White" CornerRadius="10" Padding="18" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Managed devices" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="24" FontSize="30" FontWeight="Bold" Margin="0,10,0,4"/>
                        <TextBlock Text="Sample inventory" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="10" Padding="18" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Agents online" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="21" FontSize="30" FontWeight="Bold" Margin="0,10,0,4"/>
                        <TextBlock Text="Sample status" Foreground="{StaticResource SuccessBrush}" FontSize="11"/>
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="10" Padding="18" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="IP conflicts" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="02" FontSize="30" FontWeight="Bold" Margin="0,10,0,4"/>
                        <TextBlock Text="Sample conflict records" Foreground="{StaticResource DangerBrush}" FontSize="11"/>
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="10" Padding="18">
                    <StackPanel>
                        <TextBlock Text="Offline devices" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="03" FontSize="30" FontWeight="Bold" Margin="0,10,0,4"/>
                        <TextBlock Text="Sample status" Foreground="{StaticResource WarningBrush}" FontSize="11"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Background="White" CornerRadius="10" Padding="20" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Priority scenario" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="PC-B and PC-C are shown with the same IPv4 address. The records below are illustrative only."
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,14" TextWrapping="Wrap"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1"
                                CornerRadius="8" Padding="14" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="PC-B · Target for recovery" FontWeight="SemiBold"/>
                                <TextBlock Text="192.168.110.93 / 255.255.255.0" Margin="0,8,0,0"/>
                                <TextBlock Text="Gateway: 192.168.110.9" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                <TextBlock Text="Identity: Sample RESCUE-B-001" Foreground="{StaticResource WarningBrush}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1"
                                CornerRadius="8" Padding="14" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="PC-C · Existing endpoint" FontWeight="SemiBold"/>
                                <TextBlock Text="192.168.110.93 / 255.255.255.0" Margin="0,8,0,0"/>
                                <TextBlock Text="Gateway: 192.168.110.9" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                <TextBlock Text="Identity: Sample RESCUE-C-001" Foreground="{StaticResource WarningBrush}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="10" Padding="20">
                <StackPanel>
                    <TextBlock Text="Recent events" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock Text="19:02  ·  Sample IP conflict detected for 192.168.110.93"
                               Margin="0,6" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="18:57  ·  Sample Agent heartbeat received from QA-PC-03"
                               Margin="0,6" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="18:45  ·  Demo mode started; no network changes were made"
                               Margin="0,6" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
