<UserControl x:Class="LANRescue.ConsoleApp.Views.IpRecoveryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="IP recovery" FontSize="25" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="Design preview for a controlled remote IP change workflow."
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,18"/>
            <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"
                    CornerRadius="9" Padding="14" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Demo mode — actions are disabled" Foreground="#991B1B" FontWeight="Bold"/>
                    <TextBlock Text="This screen will not change any real network configuration. A future version must authenticate the target Agent and verify the new IP allocation first."
                               Foreground="#991B1B" Margin="0,5,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="10" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="1. Target device" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="36"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Device" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="QA-PC-02 (B) · DEMO-B-001" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="1" Text="Current IPv4" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="192.168.110.93" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="2" Text="Management channel" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Not connected — sample only" VerticalAlignment="Center" Foreground="{StaticResource WarningBrush}"/>
                    </Grid>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="10" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="2. New network configuration" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14"/>
                    <TextBlock Text="Address mode" Margin="0,0,0,5"/>
                    <ComboBox x:Name="AddressModeBox" SelectedIndex="0" Width="240" HorizontalAlignment="Left"
                              IsEnabled="False" Margin="0,0,0,14">
                        <ComboBoxItem Content="Static IPv4 (sample)"/>
                        <ComboBoxItem Content="DHCP (future)"/>
                    </ComboBox>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Margin="0,0,10,12">
                            <TextBlock Text="IPv4 Address" Margin="0,0,0,5"/>
                            <TextBox Text="192.168.110.152" IsEnabled="False" Padding="8"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,12">
                            <TextBlock Text="Subnet Mask" Margin="0,0,0,5"/>
                            <TextBox Text="255.255.255.0" IsEnabled="False" Padding="8"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Margin="0,0,10,0">
                            <TextBlock Text="Default Gateway" Margin="0,0,0,5"/>
                            <TextBox Text="192.168.110.9" IsEnabled="False" Padding="8"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="DNS Server" Margin="0,0,0,5"/>
                            <TextBox Text="Company DNS (not specified)" IsEnabled="False" Padding="8"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="192.168.110.152 is an example only. Do not assign it without approval and an IPAM/DHCP check."
                               Foreground="{StaticResource WarningBrush}" Margin="0,14,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Button Content="Apply New IP — Disabled in v0.1.0" IsEnabled="False"
                    Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
