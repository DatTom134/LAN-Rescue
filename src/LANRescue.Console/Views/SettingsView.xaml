<UserControl x:Class="LANRescue.ConsoleApp.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Settings" FontSize="25" FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}"/>
        <TextBlock Text="Initial application settings and project information."
                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,18"/>
        <Border Background="White" CornerRadius="10" Padding="20">
            <StackPanel>
                <TextBlock Text="Application" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <TextBlock Text="Product name: LAN Rescue" Margin="0,5"/>
                <TextBlock Text="Version: 0.1.0" Margin="0,5"/>
                <TextBlock Text="Framework: .NET 10 / WPF" Margin="0,5"/>
                <TextBlock Text="Mode: UI prototype with sample data" Margin="0,5"/>
                <TextBlock Text="Network operations: Disabled" Foreground="{StaticResource WarningBrush}" Margin="0,5"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
