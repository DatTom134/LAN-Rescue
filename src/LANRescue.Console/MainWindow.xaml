<Window x:Class="LANRescue.ConsoleApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LAN Rescue"
        Height="820"
        Width="1320"
        MinHeight="680"
        MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="238"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource SidebarBrush}">
            <DockPanel Margin="18,22">
                <StackPanel DockPanel.Dock="Top"
                            Margin="4,0,4,28">
                    <TextBlock Text="LAN RESCUE"
                               Foreground="White"
                               FontSize="21"
                               FontWeight="Bold"/>
                    <TextBlock Text="Windows Network Recovery"
                               Foreground="#9CA3AF"
                               FontSize="11"
                               Margin="0,5,0,0"/>
                    <Border Height="1"
                            Background="#374151"
                            Margin="0,22,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="WORKSPACE"
                               Foreground="#6B7280"
                               FontSize="10"
                               FontWeight="Bold"
                               Margin="8,0,0,8"/>
                    <Button Style="{StaticResource NavButtonStyle}"
                            Content="▦   Dashboard"
                            Click="Dashboard_Click"/>
                    <Button Style="{StaticResource NavButtonStyle}"
                            Content="▤   Devices"
                            Click="Devices_Click"/>
                    <Button Style="{StaticResource NavButtonStyle}"
                            Content="⚠   IP Conflicts"
                            Click="IpConflicts_Click"/>
                    <Button Style="{StaticResource NavButtonStyle}"
                            Content="⇄   IP Recovery"
                            Click="IpRecovery_Click"/>
                    <Button Style="{StaticResource NavButtonStyle}"
                            Content="⌕   Diagnostics"
                            Click="Diagnostics_Click"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Button Style="{StaticResource NavButtonStyle}"
                            Content="⚙   Settings"
                            Click="Settings_Click"/>
                    <Border Background="#1F2937"
                            CornerRadius="9"
                            Padding="12"
                            Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="DEMO MODE"
                                       Foreground="#FBBF24"
                                       FontWeight="Bold"
                                       FontSize="10"/>
                            <TextBlock Text="Sample data only"
                                       Foreground="#D1D5DB"
                                       FontSize="11"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="68"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="34"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="28,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitleText"
                                   Text="Dashboard"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="IT NETWORK OPERATIONS"
                                   FontSize="10"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="11,6"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7"
                                     Height="7"
                                     Fill="{StaticResource WarningBrush}"
                                     Margin="0,0,8,0"/>
                            <TextBlock Text="Console: Demo Mode"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <ContentControl x:Name="PageHost"
                            Grid.Row="1"
                            Margin="28,24"/>

            <Border Grid.Row="2"
                    Background="White"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="0,1,0,0">
                <DockPanel Margin="28,0">
                    <TextBlock Text="LAN Rescue v0.1.0"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="10"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="No real network actions are enabled in this build"
                               Foreground="{StaticResource WarningBrush}"
                               FontSize="10"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
